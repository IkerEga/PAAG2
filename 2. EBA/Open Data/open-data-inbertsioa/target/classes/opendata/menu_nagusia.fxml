<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="opendata.controller.MenuNagusiaController"
      spacing="14"
      alignment="CENTER"
      style="-fx-background-color: #f6f7fb;">

    <padding>
        <Insets top="28" right="28" bottom="28" left="28"/>
    </padding>

    <!-- CARD -->
    <VBox spacing="12"
          prefWidth="560"
          maxWidth="560"
          style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-radius: 16;
                 -fx-border-color: #e6e8ef; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 12, 0.2, 0, 2);">
        <padding>
            <Insets top="22" right="22" bottom="22" left="22"/>
        </padding>

        <VBox spacing="4">
            <Label text="Menu Nagusia"
                   style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
        </VBox>

        <Separator/>

        <!-- Buttons -->
        <Button text="📉 Inflazioa"
                onAction="#joanInflaziora"
                maxWidth="1.7976931348623157E308"
                style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold;
                       -fx-background-radius: 12; -fx-padding: 12 14;"/>

        <Button text="📈 Inbertsioa (DCA)"
                onAction="#joanInbertsiora"
                maxWidth="1.7976931348623157E308"
                style="-fx-background-color: #eef1ff; -fx-text-fill: #111827; -fx-font-weight: bold;
                       -fx-background-radius: 12; -fx-padding: 12 14;"/>

        <Region prefHeight="6"/>

    </VBox>

</VBox>
