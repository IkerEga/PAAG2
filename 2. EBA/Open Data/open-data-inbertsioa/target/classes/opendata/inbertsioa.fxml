<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="opendata.controller.InbertsioaController"
            style="-fx-background-color: #f6f7fb;">

    <!-- TOP BAR -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12"
              style="-fx-background-color: white; -fx-border-color: #e6e8ef; -fx-border-width: 0 0 1 0;">
            <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>

            <Button text="⬅ Menu" onAction="#joanMenura"
                    style="-fx-background-color: #eef1ff; -fx-background-radius: 10; -fx-font-weight: bold;"/>

            <VBox spacing="2">
                <Label text="Inbertsioa"
                       style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                <Label text="DCA simulazioa: aurrezten vs inbertituta (gaurko €tan)"
                       style="-fx-text-fill: #6b7280;"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
    </top>

    <!-- LEFT: CONTROL CARD -->
    <left>
        <VBox spacing="12" prefWidth="520" maxWidth="520">
            <padding><Insets top="16" right="16" bottom="16" left="10"/></padding>

            <VBox spacing="10"
                  style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-radius: 16;
                         -fx-border-color: #e6e8ef; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 12, 0.2, 0, 2);">
                <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>

                <Label text="Sarrerak" style="-fx-font-size: 12px; -fx-font-weight: bold;"/>

                <VBox spacing="6">
                    <Label text="Indizea:" style="-fx-text-fill: #374151;"/>
                    <ComboBox fx:id="cmbIndizea"
                              style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #d7dbe7;">
                        <items>
                            <FXCollections fx:factory="observableArrayList">
                                <String fx:value="S&amp;P 500"/>
                                <String fx:value="Nasdaq 100"/>
                                <String fx:value="Ibex 35"/>
                            </FXCollections>
                        </items>
                    </ComboBox>
                </VBox>

                <VBox spacing="6">
                    <Label text="Hilabeteko ekarpena (€):" style="-fx-text-fill: #374151;"/>
                    <TextField fx:id="txtEkarpena" promptText="Adib.: 100"
                               style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #d7dbe7;"/>
                </VBox>

                <VBox spacing="6">
                    <Label text="Hasierako urtea:" style="-fx-text-fill: #374151;"/>
                    <TextField fx:id="txtUrtea" promptText="Adib.: 2000"
                               style="-fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #d7dbe7;"/>
                </VBox>

                <HBox spacing="10">
                    <Button text="📈 Kalkulatu" onAction="#kalkulatuInbertsioa"
                            style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold;
                                   -fx-background-radius: 12; -fx-padding: 10 14;"/>
                </HBox>

                <Separator/>

                <Label text="Emaitza" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                <Label fx:id="lblEmaitza" wrapText="true"
                       style="-fx-text-fill: #111827; -fx-font-size: 13px;"/>
            </VBox>

            <VBox spacing="8"
                  style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-radius: 16;
                         -fx-border-color: #e6e8ef;">
                <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                <Label text="Oharra"
                       style="-fx-font-size: 13px; -fx-font-weight: bold;"/>
                <Label wrapText="true"
                       text="Grafikoan aurrezten (gaurko €tan) eta inbertituta (gaurko €tan) konparatzen dira, inflazioaren eragina ikus dadin."
                       style="-fx-text-fill: #6b7280;"/>
            </VBox>

        </VBox>
    </left>

    <!-- CENTER: CHART CARD -->
    <center>
        <VBox spacing="10">
            <padding><Insets top="16" right="16" bottom="16" left="10"/></padding>

            <VBox spacing="10"
                  style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-radius: 16;
                         -fx-border-color: #e6e8ef; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 12, 0.2, 0, 2);">
                <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>

                <HBox alignment="CENTER_LEFT">
                    <VBox spacing="2">
                        <Label text="Grafikoa"
                               style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                        <Label text="Denborarekin aurrezkiaren eta inbertsioaren bilakaera"
                               style="-fx-text-fill: #6b7280;"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                </HBox>

                <LineChart fx:id="grafikoa"
                           title=""
                           legendVisible="true"
                           createSymbols="false"
                           animated="false"
                           VBox.vgrow="ALWAYS"
                           minHeight="400"
                           minWidth="600">
                    <xAxis><NumberAxis fx:id="xAldea" label="Urtea"/></xAxis>
                    <yAxis><NumberAxis fx:id="yAldea" label="Balioa (€)"/></yAxis>
                </LineChart>
            </VBox>

        </VBox>
    </center>

</BorderPane>
